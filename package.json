{
  "name": "girlygames",
  "version": "1.0.0",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "pm2:start": "pm2 start server.js --name app && pm2 startup && pm2 save",
    "pm2:stop": "pm2 stop app",
    "pm2:delete": "pm2 delete app",
    "pm2:restart": "pm2 restart app",
    "pm2:status": "pm2 status app",
    "pm2:logs": "pm2 logs app",
    "nvm:setup": "chmod +x ./scripts/setup_nvm.sh && ./scripts/setup_nvm.sh --version 22",
    "caddy:status": "systemctl status caddy",
    "caddy:reload": "systemctl reload caddy",
    "caddy:init": "chmod +x ./scripts/install_caddy.sh && chmod +x ./scripts/configure_caddy.sh && chmod +x ./scripts/setup_caddy.sh && ./scripts/install_caddy.sh && ./scripts/configure_caddy.sh && ./scripts/setup_caddy.sh",
    "caddy:stop": "systemctl stop caddy",
    "caddy:start": "systemctl start caddy",
    "caddy:validate": "caddy validate --config /etc/caddy/Caddyfile",
    "caddy:config-edit": "vim /etc/caddy/Caddyfile",
    "caddy:config-remove": "rm  /etc/caddy/Caddyfile",
    "caddy:logs": "journalctl -u caddy -f",
    "caddy:logs-recent": "journalctl -u caddy --no-pager -n 20",
    "setup": "npm run nvm:setup && npm run caddy:init && npm i -g pm2 && npm i -g nodemon",
    "send": "node sendMessage.js",
    "send:test": "node sendMessage.js test",
    "send:list": "node sendMessage.js list"
  },
  "dependencies": {
    "ejs": "^6.0.1",
    "express": "^5.2.1"
  }
}