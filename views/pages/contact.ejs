<%- include('../partials/head') %>
<%- include('../partials/header') %>

  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Say hi 👋</span>
      <h1>Contact Us</h1>
      <p>Questions, feedback or just want to say your favorite game? We’d love to hear from you.</p>
    </div>
  </section>

  <div class="wrap" style="padding-bottom:60px;">
    <div class="contact-grid">

      <!-- Info card -->
      <div class="contact-card">
        <h3>Get in touch 💌</h3>
        <p style="color:var(--ink-soft); font-weight:600;">The fastest way to reach us is by email —
          we usually reply within a couple of business days.</p>

        <div class="contact-line">
          <div class="ic">✉️</div>
          <div>
            <b>Email</b>
            <a class="email-big" href="mailto:contact@stand-digital.com">contact@stand-digital.com</a>
          </div>
        </div>

        <div class="contact-line">
          <div class="ic">🏢</div>
          <div>
            <b>Company</b>
            <span>Stand Digital DOO</span>
          </div>
        </div>

        <div class="contact-line">
          <div class="ic">📍</div>
          <div>
            <b>Address</b>
            <span>Soloćuša bb, Srebrenica 75430,<br>Republika Srpska, Bosnia and Herzegovina</span>
          </div>
        </div>

        <div class="contact-line">
          <div class="ic">🧾</div>
          <div>
            <b>VAT Number</b>
            <span>405016490002</span>
          </div>
        </div>
      </div>

      <!-- Form card -->
      <div class="contact-card">
        <h3>Send us a message ✨</h3>
        <p style="color:var(--ink-soft); font-weight:600;">Fill this in and it’ll open your email app,
          ready to send to our team.</p>
        <form id="contact-form">
          <div class="field">
            <label for="name">Your name</label>
            <input type="text" id="name" name="name" placeholder="e.g. Ava" required>
          </div>
          <div class="field">
            <label for="email">Your email</label>
            <input type="email" id="email" name="email" placeholder="you@example.com" required>
          </div>
          <div class="field">
            <label for="message">Message</label>
            <textarea id="message" name="message" placeholder="Tell us what’s up! 💬" required></textarea>
          </div>
          <button type="submit" class="btn" style="width:100%; justify-content:center;">Send message 💖</button>
        </form>
      </div>

    </div>
  </div>

<%- include('../partials/footer') %>
